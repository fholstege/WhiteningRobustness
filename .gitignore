plots/

# Paper drafts, Overleaf exports, local notes, and compiled LaTeX artifacts.
writing/
overleaf_iclr2027/
**/*.aux
**/*.bbl
**/*.blg
**/*.log
**/*.out
**/*.synctex.gz

# Local scratch space and exported documents/archives.
tmp/
*.pdf
*.docx
*.zip

# Editor and developer-local files.
.vscode/

# Keep only the smoke tests needed to validate paper regeneration.
tests/*
!tests/test_cifar10.py
!tests/test_regenerate_results_paper.py

# Keep the tracked README; ignore local review drafts and other Markdown notes.
*.md
!README.md
