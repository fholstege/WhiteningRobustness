# Large or locally generated inputs required only at reproduction time.
# Obtain datasets, checkpoints, and embedding bundles separately.
models/*
artifacts/*
data/

# Experiment outputs and rendered figures.
results/
results/*
results_check/
results_paper/
results_paper_v_2/
